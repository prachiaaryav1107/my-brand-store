---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Premium crystals, magnetic marvels, and aesthetic desk essentials." } = Astro.props;
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
    </style>
  </head>
  <body class="bg-gradient-to-br from-slate-50 via-indigo-50/30 to-rose-50/30 text-slate-800 antialiased selection:bg-indigo-600 selection:text-white flex flex-col min-h-screen">
    <!-- Navbar -->
    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-xl border-b border-slate-200/60 shadow-sm">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <a href="/" class="group flex items-center gap-2 text-xl font-extrabold tracking-tight text-slate-900">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-violet-600 via-pink-600 to-amber-500 flex items-center justify-center text-white shadow-md shadow-pink-500/20 group-hover:scale-105 transition">
            ✨
          </div>
          <span>LUMEN<span class="bg-gradient-to-r from-violet-600 to-pink-600 bg-clip-text text-transparent">CRAFT</span></span>
        </a>
        <div class="flex items-center space-x-8 text-sm font-semibold">
          <a href="/#products" class="text-slate-600 hover:text-violet-600 transition">Catalog</a>
          <a href="/warranty" class="text-slate-600 hover:text-violet-600 transition">Warranty</a>
          <a href="/b2b" class="text-slate-600 hover:text-violet-600 transition">Wholesale</a>
          <a href="/#products" class="bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-700 hover:to-indigo-700 text-white px-5 py-2.5 rounded-xl shadow-md shadow-indigo-500/25 transition transform active:scale-95">
            Shop Now
          </a>
        </div>
      </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-300 border-t border-slate-800 mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
          <div class="space-y-4">
            <div class="flex items-center gap-2 text-xl font-extrabold text-white">
              <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-violet-600 to-pink-600 flex items-center justify-center text-sm shadow-md">✨</div>
              <span>LUMENCRAFT</span>
            </div>
            <p class="text-sm text-slate-400 leading-relaxed">
              Curating exceptional natural crystals, high-performance magnets, and precision deskware for modern living.
            </p>
          </div>
          <div>
            <h4 class="text-xs font-bold uppercase tracking-widest text-white mb-4">Quick Links</h4>
            <ul class="space-y-2.5 text-sm text-slate-400">
              <li><a href="/#products" class="hover:text-white transition">Featured Collection</a></li>
              <li><a href="/warranty" class="hover:text-white transition">Warranty Registration</a></li>
              <li><a href="/b2b" class="hover:text-white transition">Wholesale & B2B</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-xs font-bold uppercase tracking-widest text-white mb-4">Marketplaces</h4>
            <ul class="space-y-2.5 text-sm text-slate-400">
              <li><a href="https://amazon.in" target="_blank" rel="noopener noreferrer" class="hover:text-white transition">Amazon India Store</a></li>
              <li><a href="#" class="hover:text-white transition">Direct Dispatch Portal</a></li>
              <li><a href="#" class="hover:text-white transition">Shiprocket Tracking</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-xs font-bold uppercase tracking-widest text-white mb-4">Trust & Quality</h4>
            <p class="text-sm text-slate-400 mb-4">100% genuine crystals and lab-tested neodymium magnetic alloys.</p>
            <div class="flex items-center gap-2 text-amber-400 text-sm font-bold">
              <span>⭐⭐⭐⭐⭐</span>
              <span class="text-white text-xs">4.9/5 from 10k+ buyers</span>
            </div>
          </div>
        </div>
        <div class="border-t border-slate-800 mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500">
          <p>&copy; {new Date().getFullYear()} Lumencraft Brands. All rights reserved.</p>
          <p class="mt-2 sm:mt-0">Fulfilled securely via Amazon & Direct Express Dispatch.</p>
        </div>
      </div>
    </footer>
  </body>
</html>