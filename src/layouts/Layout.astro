---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Unhinged — Obsidian & Gold custom magnets, crystals, and dark luxury desk essentials." } = Astro.props;
import "../styles/global.css";
import CartDrawer from "../components/CartDrawer.astro";
import PaymentModal from "../components/PaymentModal.astro";
import { Show, UserButton, SignInButton } from '@clerk/astro/components';
---

<!doctype html>
<html lang="en" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
    </style>
  </head>
  <body class="bg-black text-slate-100 antialiased selection:bg-amber-500 selection:text-black flex flex-col min-h-screen">
    <!-- Navbar -->
    <header class="sticky top-0 z-40 bg-black/90 backdrop-blur-xl border-b border-amber-500/20 shadow-lg shadow-black/50">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <a href="/" class="group flex items-center gap-3 text-2xl font-extrabold tracking-widest text-white">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-600 via-yellow-400 to-amber-200 flex items-center justify-center text-black shadow-lg shadow-amber-500/20 group-hover:scale-105 transition font-black">
            ⚡
          </div>
          <span>UN<span class="bg-gradient-to-r from-amber-200 via-yellow-400 to-amber-600 bg-clip-text text-transparent">HINGED</span></span>
        </a>
        <div class="hidden md:flex items-center space-x-6 text-sm font-semibold">
          <a href="/custom-magnets" class="text-amber-400 hover:text-amber-300 transition flex items-center gap-1.5 bg-amber-950/60 px-3.5 py-1.5 rounded-full border border-amber-500/30">
            <span>🧲</span> Custom Magnet Studio
          </a>
          <a href="/#products" class="text-slate-300 hover:text-amber-400 transition">Catalog</a>
          <a href="/b2b" class="text-slate-300 hover:text-amber-400 transition">Wholesale</a>
          <button class="open-saved-designs-btn text-slate-300 hover:text-amber-400 transition flex items-center gap-1.5 cursor-pointer">
            <span>📂</span> My Projects
          </button>
          <Show when={(locals) => !!locals.auth()?.userId}>
            <button onclick="window.Clerk?.openUserProfile()" class="text-slate-300 hover:text-amber-400 transition flex items-center gap-1.5 cursor-pointer">
              <span>👤</span> Account
            </button>
            <Fragment slot="fallback">
              <SignInButton mode="modal">
                <button class="text-slate-300 hover:text-amber-400 transition flex items-center gap-1.5 cursor-pointer">
                  <span>👤</span> Sign In / Account
                </button>
              </SignInButton>
            </Fragment>
          </Show>
        </div>
        <div class="flex items-center gap-3">
          <!-- Clerk Auth Show -->
          <Show when={(locals) => !!locals.auth()?.userId}>
            <button class="open-saved-designs-btn relative px-3.5 py-2.5 rounded-xl bg-zinc-900 border border-amber-500/30 hover:border-amber-400 text-amber-400 text-xs font-bold flex items-center gap-1.5 transition shadow-md" title="My Saved Designs">
              <span>📂</span> <span class="hidden sm:inline">My Projects</span>
            </button>
            <UserButton afterSignOutUrl="/" />
            <Fragment slot="fallback">
              <SignInButton mode="modal">
                <button class="relative w-11 h-11 rounded-xl bg-zinc-900 border border-amber-500/30 hover:border-amber-400 text-amber-400 flex items-center justify-center transition shadow-md" title="Sign In">
                  <span>👤</span>
                </button>
              </SignInButton>
            </Fragment>
          </Show>
          <!-- Cart Button -->
          <button class="open-cart-btn relative w-11 h-11 rounded-xl bg-zinc-900 border border-amber-500/30 hover:border-amber-400 text-amber-400 flex items-center justify-center transition shadow-md">
            <span>🛒</span>
            <span class="cart-count-badge absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-amber-400 text-black text-[10px] font-black flex items-center justify-center shadow-md hidden">0</span>
          </button>
          <a href="/custom-magnets" class="hidden sm:inline-block bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-600 hover:from-amber-500 hover:to-yellow-500 text-black px-5 py-2.5 rounded-xl shadow-lg shadow-amber-500/20 font-extrabold text-xs transition transform active:scale-95">
            Upload Design ⚡
          </a>
        </div>
      </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Cart Drawer & Payment Modal Components -->
    <CartDrawer />
    <PaymentModal />

    <!-- USER ACCOUNT / LOGIN MODAL -->
    <div id="account-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/90 backdrop-blur-md hidden transition-opacity duration-300">
      <div class="relative bg-zinc-950 border border-zinc-800 rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl text-left">
        <button id="close-account-modal-btn" class="absolute top-5 right-5 w-8 h-8 rounded-xl border border-zinc-800 text-slate-400 hover:text-white hover:border-amber-500/40 flex items-center justify-center transition">
          ✕
        </button>

        <div id="auth-logged-out-view">
          <div class="text-center mb-6">
            <div class="w-14 h-14 rounded-2xl bg-amber-400 text-black text-2xl flex items-center justify-center mx-auto mb-3 shadow-lg shadow-amber-500/20 font-black">
              👤
            </div>
            <h3 class="text-xl font-extrabold text-white">Studio Account Login</h3>
            <p class="text-xs text-slate-400 mt-1">Sign in with your email to save and resume your custom magnet designs.</p>
          </div>

          <form id="login-form" class="space-y-4">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">Your Name *</label>
              <input type="text" id="login-name" required placeholder="Aarav Sharma" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-sm text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400 transition" />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">Email Address *</label>
              <input type="email" id="login-email" required placeholder="aarav@example.com" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-sm text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400 transition" />
            </div>
            <button type="submit" class="w-full bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-600 hover:from-amber-500 hover:to-yellow-500 text-black font-extrabold py-3.5 px-4 rounded-xl shadow-lg shadow-amber-500/20 transition text-xs">
              Sign In / Register ⚡
            </button>
          </form>
        </div>

        <div id="auth-logged-in-view" class="hidden space-y-5">
          <div class="text-center mb-4">
            <div class="w-14 h-14 rounded-2xl bg-amber-400 text-black text-2xl flex items-center justify-center mx-auto mb-3 shadow-lg shadow-amber-500/20 font-black">
              ✓
            </div>
            <h3 class="text-xl font-extrabold text-white">Welcome back, <span id="user-display-name" class="text-amber-400">User</span>!</h3>
            <p id="user-display-email" class="text-xs text-slate-400 mt-1">user@example.com</p>
          </div>

          <div class="space-y-2.5">
            <button id="open-saved-designs-btn" class="w-full bg-zinc-900 hover:bg-zinc-800 text-amber-300 border border-zinc-800 font-bold py-3 px-4 rounded-xl transition text-xs flex items-center justify-center gap-2">
              <span>📂</span> View Saved Designs & Projects
            </button>
            <button id="logout-btn" class="w-full bg-red-950/40 hover:bg-red-950/70 text-red-400 border border-red-500/30 font-bold py-3 px-4 rounded-xl transition text-xs">
              Sign Out
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- SAVED DESIGNS / MY PROJECTS MODAL -->
    <div id="saved-designs-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/90 backdrop-blur-md hidden transition-opacity duration-300">
      <div class="relative bg-zinc-950 border border-zinc-800 rounded-3xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl text-left max-h-[85vh] overflow-y-auto">
        <button id="close-saved-designs-modal-btn" class="absolute top-5 right-5 w-8 h-8 rounded-xl border border-zinc-800 text-slate-400 hover:text-white hover:border-amber-500/40 flex items-center justify-center transition">
          ✕
        </button>

        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-amber-400 text-black font-extrabold flex items-center justify-center text-lg shadow-lg">
            📂
          </div>
          <div>
            <h3 class="text-xl font-extrabold text-white">My Saved Magnet Designs</h3>
            <p class="text-xs text-slate-400">Resume or reload any of your previously saved 50x50mm studio projects.</p>
          </div>
        </div>

        <div id="saved-designs-list" class="space-y-3 mb-6">
          <!-- Populated via JS -->
        </div>

        <div id="saved-designs-empty" class="text-center py-12 text-slate-500 text-xs hidden">
          No saved designs found. Go to the Custom Magnet Studio, upload your design, and click "Save Design Progress".
        </div>

        <button id="close-saved-designs-bottom-btn" class="w-full bg-zinc-900 hover:bg-zinc-800 text-white border border-zinc-800 font-bold py-3 px-4 rounded-xl transition text-xs text-center">
          Close
        </button>
      </div>
    </div>

    <script>
      function setupAccountModal() {
        const accountModal = document.getElementById('account-modal');
        const openBtn = document.getElementById('open-account-modal-btn');
        const closeBtn = document.getElementById('close-account-modal-btn');
        const loginForm = document.getElementById('login-form') as HTMLFormElement;
        const loggedOutView = document.getElementById('auth-logged-out-view');
        const loggedInView = document.getElementById('auth-logged-in-view');
        const userDisplayName = document.getElementById('user-display-name');
        const userDisplayEmail = document.getElementById('user-display-email');
        const authIndicator = document.getElementById('auth-indicator');
        const logoutBtn = document.getElementById('logout-btn');

        const savedDesignsModal = document.getElementById('saved-designs-modal');
        const openSavedDesignsBtns = document.querySelectorAll('.open-saved-designs-btn');
        const closeSavedDesignsBtn = document.getElementById('close-saved-designs-modal-btn');
        const closeSavedDesignsBottomBtn = document.getElementById('close-saved-designs-bottom-btn');

        function checkUserAuth() {
          const userJson = localStorage.getItem('unhinged_user');
          if (userJson) {
            try {
              const user = JSON.parse(userJson);
              if (user && user.email) {
                if (loggedOutView) loggedOutView.classList.add('hidden');
                if (loggedInView) loggedInView.classList.remove('hidden');
                if (userDisplayName) userDisplayName.textContent = user.name || 'User';
                if (userDisplayEmail) userDisplayEmail.textContent = user.email;
                if (authIndicator) authIndicator.classList.remove('hidden');
                return user;
              }
            } catch(e) {}
          }
          if (loggedOutView) loggedOutView.classList.remove('hidden');
          if (loggedInView) loggedInView.classList.add('hidden');
          if (authIndicator) authIndicator.classList.add('hidden');
          return null;
        }

        openBtn?.addEventListener('click', () => {
          checkUserAuth();
          if (accountModal) {
            accountModal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          }
        });

        closeBtn?.addEventListener('click', () => {
          if (accountModal) {
            accountModal.classList.add('hidden');
            document.body.style.overflow = '';
          }
        });

        loginForm?.addEventListener('submit', (e) => {
          e.preventDefault();
          const nameInput = (document.getElementById('login-name') as HTMLInputElement)?.value.trim();
          const emailInput = (document.getElementById('login-email') as HTMLInputElement)?.value.trim();
          if (nameInput && emailInput) {
            const user = { name: nameInput, email: emailInput };
            localStorage.setItem('unhinged_user', JSON.stringify(user));
            checkUserAuth();
            alert('Successfully logged in as ' + nameInput + '!');
          }
        });

        logoutBtn?.addEventListener('click', () => {
          localStorage.removeItem('unhinged_user');
          checkUserAuth();
          alert('Signed out successfully.');
          if (accountModal) accountModal.classList.add('hidden');
          document.body.style.overflow = '';
        });

        // Saved Designs Modal
        openSavedDesignsBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            if (accountModal) accountModal.classList.add('hidden');
            renderSavedDesigns();
            if (savedDesignsModal) savedDesignsModal.classList.remove('hidden');
          });
        });

        closeSavedDesignsBtn?.addEventListener('click', () => {
          if (savedDesignsModal) savedDesignsModal.classList.add('hidden');
          document.body.style.overflow = '';
        });

        closeSavedDesignsBottomBtn?.addEventListener('click', () => {
          if (savedDesignsModal) savedDesignsModal.classList.add('hidden');
          document.body.style.overflow = '';
        });

        checkUserAuth();
      }

      function getActiveUserId() {
        // @ts-ignore
        const clerkUserId = window.Clerk?.user?.id;
        if (clerkUserId) return clerkUserId;
        try {
          const userJson = localStorage.getItem('unhinged_user');
          if (userJson) {
            const user = JSON.parse(userJson);
            if (user?.id) return user.id;
            if (user?.email) return user.email;
          }
        } catch(e) {}
        return 'guest_user';
      }

      function getSavedDesignsKey() {
        return `unhinged_saved_designs_${getActiveUserId()}`;
      }

      function getSavedDesigns() {
        const key = getSavedDesignsKey();
        let designsJson = localStorage.getItem(key);
        if (!designsJson) {
          designsJson = localStorage.getItem('unhinged_saved_designs');
        }
        try {
          return designsJson ? JSON.parse(designsJson) : [];
        } catch(e) {
          return [];
        }
      }

      function saveSavedDesigns(designs: any[]) {
        const key = getSavedDesignsKey();
        localStorage.setItem(key, JSON.stringify(designs));
      }

      function renderSavedDesigns() {
        const listContainer = document.getElementById('saved-designs-list');
        const emptyContainer = document.getElementById('saved-designs-empty');
        if (!listContainer || !emptyContainer) return;

        const designs = getSavedDesigns();

        if (designs.length === 0) {
          listContainer.innerHTML = '';
          emptyContainer.classList.remove('hidden');
          return;
        }

        emptyContainer.classList.add('hidden');
        listContainer.innerHTML = designs.map((d: any, idx: number) => `
          <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-4 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3 overflow-hidden">
              <div class="w-14 h-14 rounded-xl bg-black border border-zinc-800 overflow-hidden flex items-center justify-center flex-shrink-0">
                ${d.image ? `<img src="${d.image}" class="w-full h-full object-cover" />` : '<span class="text-xl">🧲</span>'}
              </div>
              <div class="text-xs overflow-hidden">
                <h4 class="font-bold text-white truncate">${d.title || 'Custom 50x50mm Magnet'}</h4>
                <p class="text-slate-400 text-[11px]">Qty: ${d.quantity} • ${d.price} • Saved: ${d.date}</p>
              </div>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <button onclick="window.resumeSavedDesign(${idx})" class="bg-amber-400 hover:bg-amber-500 text-black font-extrabold px-3 py-2 rounded-xl text-xs transition">
                Resume ⚡
              </button>
              <button onclick="window.deleteSavedDesign(${idx})" class="bg-zinc-800 hover:bg-red-950/60 text-red-400 hover:text-red-300 px-3 py-2 rounded-xl text-xs transition border border-zinc-700">
                Delete
              </button>
            </div>
          </div>
        `).join('');
      }

      // Global window helpers for saved designs
      declare global {
        interface Window {
          resumeSavedDesign: (idx: number) => void;
          deleteSavedDesign: (idx: number) => void;
        }
      }

      window.resumeSavedDesign = (idx: number) => {
        try {
          const designs = getSavedDesigns();
          if (designs[idx]) {
            localStorage.setItem('unhinged_resume_design', JSON.stringify(designs[idx]));
            window.location.href = '/custom-magnets#studio';
          }
        } catch(e) {}
      };

      window.deleteSavedDesign = (idx: number) => {
        try {
          let designs = getSavedDesigns();
          designs.splice(idx, 1);
          saveSavedDesigns(designs);
          renderSavedDesigns();
        } catch(e) {}
      };

      document.addEventListener('DOMContentLoaded', setupAccountModal);
    </script>

    <!-- Footer -->
    <footer class="bg-zinc-950 text-slate-400 border-t border-amber-500/20 mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
          <div class="space-y-4">
            <div class="flex items-center gap-2 text-xl font-extrabold text-white tracking-widest">
              <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-amber-400 to-amber-600 flex items-center justify-center text-sm text-black font-bold shadow-md">⚡</div>
              <span>UNHINGED</span>
            </div>
            <p class="text-sm text-slate-400 leading-relaxed">
              Obsidian & gold craftsmanship for the unapologetic. Custom magnets with your personal designs, crystals, and elite deskware.
            </p>
          </div>
          <div>
            <h4 class="text-xs font-bold uppercase tracking-widest text-amber-400 mb-4">Studio Forge</h4>
            <ul class="space-y-2.5 text-sm text-slate-400">
              <li><a href="/custom-magnets" class="hover:text-amber-400 transition font-semibold text-amber-300">Custom Magnet Studio</a></li>
              <li><a href="/#products" class="hover:text-amber-400 transition">Featured Collection</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-xs font-bold uppercase tracking-widest text-amber-400 mb-4">Marketplaces</h4>
            <ul class="space-y-2.5 text-sm text-slate-400">
              <li><a href="https://amazon.in" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition">Amazon India Store</a></li>
              <li><a href="/custom-magnets#order" class="hover:text-amber-400 transition">Direct Studio Dispatch</a></li>
              <li><a href="#" class="open-payment-modal-btn hover:text-amber-400 transition cursor-pointer">Razorpay / COD Support</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-xs font-bold uppercase tracking-widest text-amber-400 mb-4">Direct Mailbox Notice</h4>
            <p class="text-xs text-slate-400 mb-2">Order confirmations & custom uploaded design files transmit directly to:</p>
            <p class="text-xs font-mono text-amber-300 bg-zinc-900 p-2.5 rounded-xl border border-amber-500/20">
              unhinged.sales1@gmail.com
            </p>
          </div>
        </div>
        <div class="border-t border-zinc-900 mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500">
          <p>&copy; {new Date().getFullYear()} Unhinged Brands. Handcrafted in small batches.</p>
          <p class="mt-2 sm:mt-0">All buttons functional • Direct Amazon & Studio fulfillment.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
