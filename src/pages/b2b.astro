---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Wholesale & B2B | Lumencraft">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center mb-12">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-600 bg-amber-50 px-3 py-1 rounded-full border border-amber-100">B2B Partnership</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-3 tracking-tight">Wholesale & Corporate Gifting</h1>
      <p class="text-slate-600 mt-2">Partner with Lumencraft for bulk orders, corporate gifting, retail distribution, and custom branded stationery.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm text-center">
        <div class="w-12 h-12 bg-violet-50 text-violet-600 rounded-2xl flex items-center justify-center mx-auto mb-4 text-xl">📦</div>
        <h3 class="font-bold text-slate-900">Low MoQs</h3>
        <p class="text-xs text-slate-500 mt-1">Starting at just 50 units for custom wholesale orders.</p>
      </div>
      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm text-center">
        <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-2xl flex items-center justify-center mx-auto mb-4 text-xl">🎁</div>
        <h3 class="font-bold text-slate-900">Corporate Gifting</h3>
        <p class="text-xs text-slate-500 mt-1">Custom engraved brass pens and bespoke gift boxes.</p>
      </div>
      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm text-center">
        <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center mx-auto mb-4 text-xl">⚡</div>
        <h3 class="font-bold text-slate-900">Priority B2B Pricing</h3>
        <p class="text-xs text-slate-500 mt-1">Tiered volume discounts up to 40% off retail pricing.</p>
      </div>
    </div>

    <div class="bg-white p-8 sm:p-10 rounded-3xl border border-slate-200/80 shadow-sm">
      <form class="space-y-6" onsubmit="event.preventDefault(); alert('Wholesale inquiry submitted! Our B2B team will contact you within 24 hours.');">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Contact Name</label>
            <input type="text" required placeholder="Priya Menon" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-violet-600 transition" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Business Email</label>
            <input type="email" required placeholder="priya@company.com" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-violet-600 transition" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Company / Store Name</label>
            <input type="text" required placeholder="Design Studio Inc." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-violet-600 transition" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Estimated Quantity</label>
            <select class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-violet-600 transition text-slate-700">
              <option>50 - 200 units</option>
              <option>200 - 500 units</option>
              <option>500 - 2,000 units</option>
              <option>2,000+ units (Enterprise)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Inquiry Details & Requirements</label>
          <textarea rows="4" placeholder="Tell us about your corporate gifting or retail wholesale needs..." class="w-full bg-slate-50 border border-slate-200 rounded-xl p-4 text-sm focus:outline-none focus:border-violet-600 transition"></textarea>
        </div>

        <button type="submit" class="w-full bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-700 hover:to-indigo-700 text-white font-bold py-4 rounded-xl shadow-lg shadow-indigo-500/25 transition transform active:scale-95">
          Submit Wholesale Request 🤝
        </button>
      </form>
    </div>
  </div>
</Layout>
