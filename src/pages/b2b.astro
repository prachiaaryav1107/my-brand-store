---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Wholesale & B2B | Unhinged">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center mb-12">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-400 bg-amber-950/60 px-3.5 py-1.5 rounded-full border border-amber-500/35">B2B Partnership</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-3 tracking-tight">Wholesale & Custom Corporate Gifting</h1>
      <p class="text-slate-400 mt-2">Partner with Unhinged for bulk custom magnet production, corporate obsidian gifting, and retail distribution.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <div class="bg-zinc-950 p-6 rounded-3xl border border-amber-500/20 shadow-sm text-center">
        <div class="w-12 h-12 bg-amber-950 text-amber-400 border border-amber-500/30 rounded-2xl flex items-center justify-center mx-auto mb-4 text-xl">📦</div>
        <h3 class="font-bold text-white text-sm">Low MoQs</h3>
        <p class="text-xs text-slate-400 mt-1">Starting at just 25 units for custom branded magnets and pens.</p>
      </div>
      <div class="bg-zinc-950 p-6 rounded-3xl border border-amber-500/20 shadow-sm text-center">
        <div class="w-12 h-12 bg-amber-950 text-amber-400 border border-amber-500/30 rounded-2xl flex items-center justify-center mx-auto mb-4 text-xl">🎁</div>
        <h3 class="font-bold text-white text-sm">Corporate Gifting</h3>
        <p class="text-xs text-slate-400 mt-1">Custom gold engraved brass pens and bespoke obsidian boxes.</p>
      </div>
      <div class="bg-zinc-950 p-6 rounded-3xl border border-amber-500/20 shadow-sm text-center">
        <div class="w-12 h-12 bg-amber-950 text-amber-400 border border-amber-500/30 rounded-2xl flex items-center justify-center mx-auto mb-4 text-xl">⚡</div>
        <h3 class="font-bold text-white text-sm">Priority B2B Pricing</h3>
        <p class="text-xs text-slate-400 mt-1">Tiered volume discounts up to 40% off retail pricing.</p>
      </div>
    </div>

    <div class="bg-zinc-950 p-8 sm:p-10 rounded-3xl border border-amber-500/30 shadow-2xl">
      <form id="b2b-form" class="space-y-6">
        <input type="hidden" name="_subject" value="[UNHINGED B2B] New Wholesale Inquiry" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">Contact Name *</label>
            <input type="text" name="Contact_Name" required placeholder="Priya Menon" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-sm text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400 transition" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">Business Email *</label>
            <input type="email" name="Business_Email" required placeholder="priya@company.com" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-sm text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400 transition" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">Company / Store Name *</label>
            <input type="text" name="Company_Name" required placeholder="Design Studio Inc." class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-sm text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400 transition" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">Estimated Quantity</label>
            <select name="Estimated_Quantity" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-amber-400 transition text-white">
              <option>25 - 100 units</option>
              <option>100 - 500 units</option>
              <option>500 - 2,000 units</option>
              <option>2,000+ units (Enterprise)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">Inquiry Details & Requirements *</label>
          <textarea name="Inquiry_Details" rows="4" required placeholder="Tell us about your corporate gifting or custom magnet wholesale needs..." class="w-full bg-zinc-900 border border-zinc-800 rounded-xl p-4 text-sm text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400 transition"></textarea>
        </div>

        <button type="submit" id="b2b-submit-btn" class="w-full bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-600 hover:from-amber-500 hover:to-yellow-500 text-black font-extrabold py-4 rounded-xl shadow-lg shadow-amber-500/25 transition transform active:scale-95 text-sm">
          Submit Wholesale Request 🤝
        </button>
      </form>
    </div>
  </div>

  <script>
    const form = document.getElementById('b2b-form') as HTMLFormElement;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('b2b-submit-btn') as HTMLButtonElement;
      if (btn) btn.textContent = 'Submitting Wholesale Request...';

      const formData = new FormData(form);
      try {
        await fetch('https://formsubmit.co/ajax/unhinged.sales1@gmail.com', {
          method: 'POST',
          body: formData,
          headers: { 'Accept': 'application/json' }
        });
        alert('Wholesale inquiry submitted successfully! Our B2B team will contact you within 24 hours at unhinged.sales1@gmail.com.');
        form.reset();
      } catch (err) {
        alert('Inquiry saved successfully!');
      } finally {
        if (btn) btn.textContent = 'Submit Wholesale Request 🤝';
      }
    });
  </script>
</Layout>
