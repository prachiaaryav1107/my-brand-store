---
import Layout from "../../layouts/Layout.astro";
import { products } from "../../data/products";

export async function getStaticPaths() {
  return products.map(product => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
---

<Layout title={`${product.title} | Unhinged Store`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      
      <!-- Product Image Gallery / Emoji Showcase -->
      <div class="relative bg-gradient-to-br from-zinc-900 to-black rounded-3xl overflow-hidden aspect-square flex items-center justify-center border border-amber-500/30 shadow-2xl group">
        <span class="text-9xl transform group-hover:scale-110 transition duration-500 filter drop-shadow-[0_15px_25px_rgba(251,191,36,0.3)]">{product.emoji}</span>
        <div class="absolute top-6 left-6">
          <span class="text-xs font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-full border bg-amber-950/40 text-amber-300 border-amber-500/30 shadow-sm">
            {product.category}
          </span>
        </div>
      </div>

      <!-- Product Details & Actions -->
      <div class="flex flex-col space-y-6">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="text-amber-400 text-sm">⭐⭐⭐⭐⭐</span>
            <span class="text-xs font-bold text-white">4.9 / 5.0</span>
            <span class="text-xs text-slate-500">(Verified Studio Batch)</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">{product.title}</h1>
          <p class="text-3xl font-extrabold text-amber-400 mt-3">{product.price}</p>
        </div>

        <p class="text-slate-300 leading-relaxed text-base">{product.description}</p>

        <!-- Specs List -->
        <div class="bg-zinc-950 border border-amber-500/20 rounded-2xl p-5 space-y-2.5">
          <h4 class="text-xs font-bold uppercase tracking-widest text-amber-400 mb-2">Craftsmanship Specs</h4>
          {product.specs.map(spec => (
            <div class="flex items-center gap-2.5 text-xs text-slate-300">
              <span class="w-4 h-4 rounded-full bg-amber-950 text-amber-400 border border-amber-500/30 flex items-center justify-center text-[10px]">✓</span>
              <span>{spec}</span>
            </div>
          ))}
        </div>

        <!-- Highlights Checklist -->
        <div class="grid grid-cols-2 gap-4 py-4 border-y border-amber-500/20">
          <div class="flex items-center gap-2 text-xs font-semibold text-slate-300">
            <span class="w-5 h-5 rounded-full bg-amber-950 text-amber-400 border border-amber-500/30 flex items-center justify-center">✓</span> Free Shipping on ₹500+
          </div>
          <div class="flex items-center gap-2 text-xs font-semibold text-slate-300">
            <span class="w-5 h-5 rounded-full bg-amber-950 text-amber-400 border border-amber-500/30 flex items-center justify-center">✓</span> 1 Year Gold Warranty
          </div>
          <div class="flex items-center gap-2 text-xs font-semibold text-slate-300">
            <span class="w-5 h-5 rounded-full bg-amber-950 text-amber-400 border border-amber-500/30 flex items-center justify-center">✓</span> Obsidian Black Build
          </div>
          <div class="flex items-center gap-2 text-xs font-semibold text-slate-300">
            <span class="w-5 h-5 rounded-full bg-amber-950 text-amber-400 border border-amber-500/30 flex items-center justify-center">✓</span> Easy 10-Day Returns
          </div>
        </div>

        <!-- Dual Call to Action Area -->
        <div class="space-y-4 pt-2">
          {product.isCustomizable ? (
            <a 
              href="/custom-magnets"
              class="w-full flex items-center justify-center gap-3 bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-600 hover:from-amber-500 hover:to-yellow-500 text-black font-extrabold py-4 px-8 rounded-2xl shadow-lg shadow-amber-500/20 transition transform active:scale-[0.99]"
            >
              <span>🧲</span> Upload Your Design in Studio
            </a>
          ) : (
            <a 
              href={product.amazonUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-full flex items-center justify-center gap-3 bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-600 hover:from-amber-500 hover:to-yellow-500 text-black font-extrabold py-4 px-8 rounded-2xl shadow-lg shadow-amber-500/20 transition transform active:scale-[0.99]"
            >
              <span>🛒</span> Buy Securely on Amazon India
            </a>
          )}

          <!-- Direct Purchase / Cart Trigger Box -->
          <div class="p-6 bg-zinc-950 border border-amber-500/20 rounded-2xl shadow-sm space-y-4">
            <div>
              <h3 class="text-sm font-bold text-white mb-1">Direct Express Dispatch</h3>
              <p class="text-xs text-slate-400">Shipped directly from our obsidian vault via Shiprocket.</p>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <button 
                type="button"
                id="add-to-bag-detail-btn"
                class="w-full bg-amber-950/60 hover:bg-amber-900/60 text-amber-300 border border-amber-500/30 text-xs font-bold py-3 px-4 rounded-xl transition flex items-center justify-center gap-2"
              >
                <span>🛒</span> Add to Obsidian Bag
              </button>
              <button 
                type="button"
                class="open-payment-modal-btn w-full bg-zinc-900 hover:bg-zinc-800 text-slate-300 border border-zinc-800 text-xs font-bold py-3 px-4 rounded-xl transition flex items-center justify-center gap-2"
              >
                <span>⚡</span> Pay via UPI / Cards / COD
              </button>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script define:vars={{ product }}>
    document.addEventListener('DOMContentLoaded', () => {
      const addBtn = document.getElementById('add-to-bag-detail-btn');
      addBtn?.addEventListener('click', () => {
        const item = {
          id: product.slug + '-' + Date.now(),
          slug: product.slug,
          title: product.title,
          price: product.priceNumber,
          quantity: 1,
          emoji: product.emoji,
          options: product.category
        };
        window.dispatchEvent(new CustomEvent('unhinged-add-to-cart', { detail: item }));
      });
    });
  </script>
</Layout>
