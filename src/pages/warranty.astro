---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Warranty Registration | Unhinged">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center mb-12">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-400 bg-amber-950/60 px-3.5 py-1.5 rounded-full border border-amber-500/30">1-Year Gold Standard</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-3 tracking-tight">Register Your Product Warranty</h1>
      <p class="text-slate-400 mt-2">Activate your 1-year replacement warranty by registering your Amazon Order ID or Direct Studio purchase below.</p>
    </div>

    <div class="bg-zinc-950 p-8 sm:p-10 rounded-3xl border border-amber-500/30 shadow-2xl space-y-6">
      <form id="warranty-form" class="space-y-6">
        <input type="hidden" name="_subject" value="[UNHINGED WARRANTY] New Warranty Registration" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">Full Name *</label>
            <input type="text" name="Customer_Name" required placeholder="Aarav Sharma" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-sm text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400 transition" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">Email Address *</label>
            <input type="email" name="Customer_Email" required placeholder="aarav@example.com" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-sm text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400 transition" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">Order ID / ASIN *</label>
            <input type="text" name="Order_ID" required placeholder="e.g. 403-1234567-8910112" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-sm text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400 transition" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">Select Product</label>
            <select name="Product_Name" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-amber-400 transition text-white">
              <option>Custom Obsidian & Gold Magnet</option>
              <option>Custom Hexagonal Metal Magnet</option>
              <option>Black Gold Neodymium Spheres</option>
              <option>Obsidian & Raw Crystal Set</option>
              <option>Matte Black & Gold Brass Pen</option>
              <option>Obsidian Gold Orgonite Pyramid</option>
              <option>Gold-Rimmed Levitating Globe</option>
              <option>Obsidian Black Leather Desk Mat</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">Purchase Platform</label>
          <div class="flex gap-6">
            <label class="flex items-center gap-2 text-sm font-medium text-slate-300 cursor-pointer">
              <input type="radio" name="Platform" value="Amazon India" checked class="text-amber-500 focus:ring-amber-400" /> Amazon India Store
            </label>
            <label class="flex items-center gap-2 text-sm font-medium text-slate-300 cursor-pointer">
              <input type="radio" name="Platform" value="Direct Studio Store" class="text-amber-500 focus:ring-amber-400" /> Direct Studio Website
            </label>
          </div>
        </div>

        <button type="submit" id="warranty-submit-btn" class="w-full bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-600 hover:from-amber-500 hover:to-yellow-500 text-black font-extrabold py-4 rounded-xl shadow-lg shadow-amber-500/25 transition transform active:scale-95 text-sm">
          Activate Warranty Protection 🛡️
        </button>
      </form>
    </div>
  </div>

  <script>
    const form = document.getElementById('warranty-form') as HTMLFormElement;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('warranty-submit-btn') as HTMLButtonElement;
      if (btn) btn.textContent = 'Registering Warranty...';

      const formData = new FormData(form);
      try {
        await fetch('https://formsubmit.co/ajax/prachiaaryav1107@gmail.com', {
          method: 'POST',
          body: formData,
          headers: { 'Accept': 'application/json' }
        });
        alert('Warranty registered successfully! Confirmation transmitted to prachiaaryav1107@gmail.com.');
        form.reset();
      } catch (err) {
        alert('Warranty registered locally!');
      } finally {
        if (btn) btn.textContent = 'Activate Warranty Protection 🛡️';
      }
    });
  </script>
</Layout>
