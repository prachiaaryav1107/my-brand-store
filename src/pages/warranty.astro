---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Warranty Registration | Lumencraft">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center mb-12">
      <span class="text-xs font-bold uppercase tracking-widest text-violet-600 bg-violet-50 px-3 py-1 rounded-full border border-violet-100">1-Year Protection</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-3 tracking-tight">Register Your Product Warranty</h1>
      <p class="text-slate-600 mt-2">Activate your 1-year replacement warranty by registering your Amazon Order ID or Direct Purchase invoice below.</p>
    </div>

    <div class="bg-white p-8 sm:p-10 rounded-3xl border border-slate-200/80 shadow-sm space-y-6">
      <form class="space-y-6" onsubmit="event.preventDefault(); alert('Warranty registered successfully! Confirmation sent to your email.');">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Full Name</label>
            <input type="text" required placeholder="Aarav Sharma" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-violet-600 transition" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Email Address</label>
            <input type="email" required placeholder="aarav@example.com" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-violet-600 transition" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Order ID / ASIN (Amazon or Direct)</label>
            <input type="text" required placeholder="e.g. 403-1234567-8910112" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-violet-600 transition" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Select Product</label>
            <select class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-violet-600 transition text-slate-700">
              <option>Raw Healing Crystal Set</option>
              <option>Neodymium Magnetic Spheres</option>
              <option>Precision Heavyweight Brass Pen</option>
              <option>Energy Generator Orgonite Pyramid</option>
              <option>Magnetic Levitating Desk Globe</option>
              <option>Premium PU Leather Desk Mat</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Purchase Platform</label>
          <div class="flex gap-4">
            <label class="flex items-center gap-2 text-sm font-medium text-slate-700 cursor-pointer">
              <input type="radio" name="platform" checked class="text-violet-600 focus:ring-violet-500" /> Amazon India
            </label>
            <label class="flex items-center gap-2 text-sm font-medium text-slate-700 cursor-pointer">
              <input type="radio" name="platform" class="text-violet-600 focus:ring-violet-500" /> Direct Website Store
            </label>
          </div>
        </div>

        <button type="submit" class="w-full bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-700 hover:to-indigo-700 text-white font-bold py-4 rounded-xl shadow-lg shadow-indigo-500/25 transition transform active:scale-95">
          Activate Warranty Protection 🛡️
        </button>
      </form>
    </div>
  </div>
</Layout>
